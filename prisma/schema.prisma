generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Takım kullanımı eklendiğinde: Team ve User modelleri gelecek,
// Objective'e ownerId / teamId alanları bağlanacak.
model Objective {
  id          String      @id @default(cuid())
  title       String
  description String?
  period      String // ör. "2026-Q4"
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  keyResults  KeyResult[]
}

model KeyResult {
  id           String    @id @default(cuid())
  objectiveId  String
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title        String
  startValue   Float     @default(0)
  targetValue  Float
  currentValue Float     @default(0)
  unit         String? // ör. "%", "müşteri", "TL"
  createdAt    DateTime  @default(now())
  checkIns     CheckIn[]
}

// Her ilerleme güncellemesi bir check-in olarak saklanır (geçmiş için).
model CheckIn {
  id          String    @id @default(cuid())
  keyResultId String
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  value       Float
  note        String?
  createdAt   DateTime  @default(now())
}
